{
  "expo": {
    "name": "DS Messenger",
    "slug": "ds-messenger",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ds-messenger",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.amiraatour.dsmessenger"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "برای ذخیره و مشاهده فایل‌ها نیاز به دسترسی داریم.",
          "savePhotosPermission": "برای ذخیره تصاویر نیاز به دسترسی داریم.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "برای نمایش مخاطبین گوشی نیاز به دسترسی داریم."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "برای انتخاب تصویر نیاز به دسترسی داریم.",
          "cameraPermission": "برای گرفتن عکس نیاز به دسترسی داریم."
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "برای ضبط پیام صوتی نیاز به دسترسی داریم."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8909d14a-10c8-4c92-b99e-71e6050b5801"
      }
    }
  }
}
